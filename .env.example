# Copy to .env. Blank or `#`-prefixed values count as unset.

# Graph
FALKORDB_PASSWORD=aftershock
FALKORDB_URL=redis://:aftershock@localhost:6390

# API. Set a long random key before exposing the API beyond localhost: it guards every /api route except /health,
# and /mcp. The web app sends it server-side; browsers never see it.
AFTERSHOCK_API_KEY=
AFTERSHOCK_WEB_ORIGIN=http://localhost:3101
# Directories the API may index (os.pathsep-separated). Empty = the API's working directory only.
AFTERSHOCK_REPO_ROOTS=
AFTERSHOCK_ALLOWED_CLONE_HOSTS=github.com,gitlab.com,bitbucket.org,codeberg.org

# Optional: free-form questions in "Ask". Without it, common question shapes are answered by a deterministic router.
ANTHROPIC_API_KEY=
AFTERSHOCK_MODEL=claude-opus-5-5
# Extra Host headers /mcp accepts besides localhost (e.g. your public hostname).
AFTERSHOCK_ALLOWED_HOSTS=
# Let the web Tests page run a repo's tests (executes repo code; loopback clients only). Off unless 1.
AFTERSHOCK_ALLOW_RUN=
# D29: comma-separated repos any visitor may run, set up and install tools for (capped, one public run at a time).
# Provision them with scripts/showcase.sh. Never set ALLOW_RUN=1 on a public host; this is the public opening.
AFTERSHOCK_SHOWCASE_REPOS=
AFTERSHOCK_PUBLIC_RUN_TIMEOUT=

# Web UI. It proxies the API server-side; anyone who can reach it can use the API through it, so set a password
# before binding it beyond localhost (the browser asks for it via HTTP Basic, any user name).
AFTERSHOCK_WEB_PASSWORD=
# For `npm run dev` / `npm run start` outside compose; compose wires it to the api service.
AFTERSHOCK_API_URL=http://127.0.0.1:8100

# docker compose host bindings (loopback by default)
API_BIND=127.0.0.1
API_PORT=8100
WEB_BIND=127.0.0.1
WEB_PORT=3101
FALKORDB_PORT=6390
